# Optional: copy to .env to change defaults. .env is never committed.

# Free-text requests are read by a free local model (Ollama) by default.
# INTENT_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b
# On a Mac, the native Ollama app is much faster than Docker (it uses the GPU):
# install it, run `ollama pull qwen2.5:3b`, then set
# OLLAMA_URL=http://host.docker.internal:11434

# To use Claude instead (paid, more accurate):
# INTENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Routing data tiles (default covers Île-de-France) and web port
# BROUTER_TILES=E0_N45
# WEB_PORT=3000
